# Copia este archivo como .env.local y llena los valores desde tu proyecto de Supabase.
# La clave anon es publica por diseno, la seguridad real vive en las politicas RLS de la base.
# NUNCA pongas aqui la service_role key. Esa no se usa en esta aplicacion.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-ANON
